# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finik_db
DB_USER=postgres
DB_PASSWORD=your_password

# Finik API Configuration
# Получите эти значения от представителей Финика
FINIK_API_KEY=your_api_key_from_finik

# ВАЖНО: Приватный ключ должен быть в одну строку с \n для переносов
# Или используйте реальные переносы строк (см. инструкцию ниже)
FINIK_PRIVATE_PEM="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----"

# Альтернативный способ (рекомендуется): используйте реальные переносы строк
# FINIK_PRIVATE_PEM="-----BEGIN PRIVATE KEY-----
# MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
# -----END PRIVATE KEY-----"

FINIK_ACCOUNT_ID=your_account_id_from_finik
FINIK_ENVIRONMENT=production
# Используйте 'beta' для тестового окружения или 'production' для продакшена

# Путь API для создания платежа (по умолчанию /payment)
# Если Финик использует /v1/payment, установите: FINIK_API_PATH=/v1/payment
# FINIK_API_PATH=/payment

# Server IP (for callbacks)
SERVER_IP=2.56.179.126
SERVER_URL=http://2.56.179.126:3000

