# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finik_db
DB_USER=postgres
DB_PASSWORD=your_password

# Finik API Configuration
# Получите эти значения от представителей Финика
FINIK_API_KEY=your_api_key_from_finik
FINIK_ACCOUNT_ID=your_account_id_from_finik

# Окружение: 'beta' или 'prod' (для production)
FINIK_ENV=beta
# Альтернативное название (для совместимости)
FINIK_ENVIRONMENT=beta

# Приватный ключ (RSA PRIVATE KEY)
# ⚠️ Private key хранить ТОЛЬКО в backend
FINIK_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
MIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...
-----END RSA PRIVATE KEY-----"

# Публичный ключ (для проверки webhook)
FINIK_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----
MIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEA...
-----END PUBLIC KEY-----"

# Server IP (for callbacks)
SERVER_IP=2.56.179.126
SERVER_URL=http://2.56.179.126:3000

