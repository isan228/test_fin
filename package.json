{
  "name": "finik-api-manager",
  "version": "1.0.0",
  "description": "API ключи системы оплаты Финик",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo",
    "check-key": "node -e \"require('./utils/checkKey').checkPrivateKey()\"",
    "diagnose": "node utils/diagnosePayment.js",
    "test-signature": "node utils/testSignature.js",
    "extract-public-key": "node utils/extractPublicKey.js",
    "generate-keys": "node generate-keys-simple.js",
    "generate-keys": "node generate-keys-simple.js"
  },
  "keywords": ["finik", "payment", "api"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "sequelize": "^6.35.0",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "node-forge": "^1.3.1",
    "axios": "^1.6.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}

